{
  "version": "2.0.0",
  "tasks": [
    {"label": "Workbench: doctor", "type": "process", "command": ".venv/bin/python", "args": ["tools/workbench.py", "doctor"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []},
    {"label": "Workbench: import STEP for review", "type": "process", "command": ".venv/bin/python", "args": ["tools/workbench.py", "review-import", "--step", "${input:stepPath}"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []},
    {"label": "Workbench: serve requirements viewer", "type": "process", "command": ".venv/bin/python", "args": ["tools/workbench.py", "review-serve", "${input:reviewPath}"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []},
    {"label": "Workbench: simulate spec", "type": "process", "command": ".venv/bin/python", "args": ["tools/workbench.py", "simulate", "${input:specPath}"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []},
    {"label": "Workbench: run status", "type": "process", "command": ".venv/bin/python", "args": ["tools/workbench.py", "status", "${input:runPath}"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []},
    {"label": "Workbench: serve results viewer", "type": "process", "command": ".venv/bin/python", "args": ["tools/workbench.py", "results-serve", "${input:resultsPath}", "--port", "8766"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []},
    {"label": "Workbench: tests", "type": "process", "command": ".venv/bin/python", "args": ["tools/workbench.py", "test"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": []}
  ],
  "inputs": [
    {"id": "stepPath", "type": "promptString", "description": "STEP path relative to workspace", "default": "inputs/part.step"},
    {"id": "reviewPath", "type": "promptString", "description": "Review directory printed by review-import", "default": "runs/"},
    {"id": "specPath", "type": "promptString", "description": "Spec JSON", "default": "specs/example-manifold-40lpm.json"},
    {"id": "runPath", "type": "promptString", "description": "Run directory", "default": "runs/"},
    {"id": "resultsPath", "type": "promptString", "description": "Export directory under runs/<run>/results-viewer", "default": "runs/"}
  ]
}
